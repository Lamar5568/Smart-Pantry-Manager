<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvIngredientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingredient Name"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIngredientDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantity and Unit"
            android:textSize="14sp" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnEditIngredient"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_edit"
        android:contentDescription="Edit ingredient"
        android:clickable="true"
        android:focusable="true" />

    <ImageButton
        android:id="@+id/btnDeleteIngredient"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="Delete ingredient"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>